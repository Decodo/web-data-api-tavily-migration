# Copy this file to .env and fill in your key:  cp .env.example .env

# Required. Your Web Data API key, sent as a Bearer token to https://data.decodo.com/v1
# Get one on the free plan: https://decodo.com/web-data-api
DECODO_AUTH_TOKEN=your-web-data-api-key

# Optional. Only needed to keep Tavily as a fallback or to run the shadow evaluation
# against both backends (shadow_eval.py).
# TAVILY_API_KEY=your-tavily-key

# Optional. Which backend the tools use: "decodo" (default) or "tavily".
# RETRIEVER=decodo
